# Base de datos PostgreSQL (en Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=
# Secreto de sesiones, 32+ caracteres aleatorios (en Railway: ${{secret(48)}}; local: openssl rand -hex 32)
AUTH_SECRET=

# --- Opcional ---
# Lectura con IA de recibos, listas de materiales y cotizaciones. Sin clave, se llena a mano.
# Se usa OpenAI si existe OPENAI_API_KEY; si no, Claude con ANTHROPIC_API_KEY.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5
# ANTHROPIC_API_KEY=
# URL pública solo si usa un dominio propio (en Railway se toma sola de RAILWAY_PUBLIC_DOMAIN)
# APP_URL=https://obra.su-dominio.cr
# Avisos en el celular: si no se definen, las claves se generan solas y se guardan en la base
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:su-correo@ejemplo.com
